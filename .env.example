# Local bind port used by run.sh.
MAILTRACE_PORT=8777

# Optional Groq/Qwen analyst assistance for MailTrace.
# Keep the real key in your local environment; never commit it.
MAILTRACE_LLM_ENABLED=0
MAILTRACE_LLM_MODEL=qwen/qwen3.8-27b
MAILTRACE_LLM_TIMEOUT=25
# GROQ_API_KEY=replace-locally-only

# Live intelligence (laptop demo). Tests force these off.
MAILTRACE_LIVE_GEO=0
MAILTRACE_LIVE_DNS=0
MAILTRACE_DNS_TIMEOUT=2.5
# MAILTRACE_GEOIP_DB=data/GeoLite2-City.mmdb
# MAILTRACE_GEOIP_ASN_DB=data/GeoLite2-ASN.mmdb
